{
  "name": "dodgeborn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": "22.x" },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts",
    "dev:local": "node --disable-warning=ExperimentalWarning scripts/dev-server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:local": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test tests/unit/core.test.ts tests/integration/match.test.ts tests/ai/ai.test.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:browser:local": "node --disable-warning=ExperimentalWarning scripts/browser-smoke.mjs",
    "test:browser:built": "node --disable-warning=ExperimentalWarning scripts/browser-smoke.mjs --built",
    "test:portable": "node --disable-warning=ExperimentalWarning scripts/portable-smoke.mjs",
    "build": "npm run typecheck && vite build --config apps/web/vite.config.ts",
    "build:local": "node --disable-warning=ExperimentalWarning scripts/build-local.mjs",
    "package:portable": "node --disable-warning=ExperimentalWarning scripts/package-portable.mjs",
    "package:source": "node scripts/prepare-open-source.mjs",
    "preview": "vite preview --config apps/web/vite.config.ts"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  }
}
